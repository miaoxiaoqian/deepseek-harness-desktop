{
  "name": "deepseek-harness-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.1.3",
  "description": "DeepSeek Harness Universal Cross-Platform Native Desktop Application (macOS & Windows)",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron src/main.cjs",
    "build:mac": "electron-builder --mac --dir",
    "pack:dmg": "electron-builder --mac dmg",
    "pack:win": "electron-builder --win nsis",
    "dist": "npm run build:mac",
    "rebuild": "electron-rebuild -f -w node-pty"
  },
  "build": {
    "appId": "com.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir",
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "agent",
    "desktop",
    "electron",
    "macos",
    "windows"
  ],
  "author": "DeepSeek AI & Community",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
